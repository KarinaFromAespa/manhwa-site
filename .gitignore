# Cached API responses and proxied images.
/cache/*
!/cache/.gitignore

# Optional local config overrides (never commit secrets).
/lib/config.local.php

# Fetched catalog data lives ONLY on the live site (FTP), never in git.
# The fetch workflows download it from FTP as the merge base and
# upload the result back via FTP. Keep it out of the repo and its history.
/data/
fetcher/state.json

# Python bytecode caches.
__pycache__/
*.pyc
